# 测试容器的变量清单。复制成 deploy/.env 后填写；deploy/.env 不入库。
#   cp deploy/.env.example deploy/.env

# ── 网络 ─────────────────────────────────────────────────────────────
# 复用的桥接网络名；缺省用开发环境的网络。宿主的端口防护只放行白名单网段，
# 换网络前先确认目标网段在放行清单里。
CHATDSH_TEST_NETWORK=chatdsh-dev_default
# 该网络的网关地址，容器经它访问宿主上的 20128。用下面这条命令取：
#   docker network inspect chatdsh-dev_default --format '{{range .IPAM.Config}}{{.Gateway}}{{end}}'
CHATDSH_TEST_GATEWAY=

# ── Hermes ───────────────────────────────────────────────────────────
# api_server 的访问密钥，测试容器与真实实例必须不同。
HERMES_API_KEY=
# 容器镜像。
HERMES_IMAGE=nousresearch/hermes-agent:latest

# ── 模型网关 ─────────────────────────────────────────────────────────
# 宿主机 OmniRoute。容器内访问宿主统一用 host.docker.internal。
CHATDSH_TEST_GATEWAY_URL=http://host.docker.internal:20128/v1
CHATDSH_TEST_GATEWAY_MODEL=xhs/dots3-note-prev
CHATDSH_TEST_GATEWAY_API_KEY=

# ── Hindsight ────────────────────────────────────────────────────────
HINDSIGHT_IMAGE=ghcr.nju.edu.cn/vectorize-io/hindsight:0.9.2
HINDSIGHT_DB_USER=hindsight
HINDSIGHT_DB_PASSWORD=
HINDSIGHT_DB_NAME=hindsight
HINDSIGHT_DB_IMAGE=docker.1panel.live/tensorchord/vchord-postgres:pg18-v1.1.1
HINDSIGHT_LLM_PROVIDER=openai
HINDSIGHT_LLM_BASE_URL=http://host.docker.internal:20128/v1
HINDSIGHT_LLM_MODEL=xhs/dots3-note-prev
HINDSIGHT_LLM_API_KEY=
HINDSIGHT_EMBEDDINGS_PROVIDER=openai
HINDSIGHT_EMBEDDINGS_BASE_URL=http://host.docker.internal:20128/v1
HINDSIGHT_EMBEDDINGS_MODEL=
HINDSIGHT_EMBEDDINGS_API_KEY=

# ── 独立 Postgres（存储后端联调）────────────────────────────────────
CHATDSH_DB_USER=chatdsh
CHATDSH_DB_PASSWORD=
CHATDSH_DB_NAME=chatdsh
CHATDSH_DB_IMAGE=postgres:18
