{
  "name": "@chatdsh/e2e-client-remote-bridge",
  "version": "0.0.0",
  "private": true,
  "description": "只能用于端到端联调的客户端桥：把页面里的 remote 对象暴露到全局，供 CDP 调用",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes"
      ],
      "immediately": true
    }
  }
}
