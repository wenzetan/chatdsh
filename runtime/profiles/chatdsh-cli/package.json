{
  "name": "dsh-profile-chatdsh-cli",
  "version": "0.1.0",
  "private": true,
  "description": "ChatDSH 的命令行 profile：dsh-base 加 dsh-tui，交互全部在终端里",
  "dependencies": {
    "@chatdsh/adapter": "link:../../../dsh-adapter",
    "@chatdsh/client-automation": "link:../../packages/client/automation",
    "@chatdsh/client-conversation": "link:../../packages/client/conversation",
    "@chatdsh/client-data-management": "link:../../packages/client/data-management",
    "@chatdsh/client-desktop-control": "link:../../packages/client/desktop-control",
    "@chatdsh/client-exports": "link:../../packages/client/exports",
    "@chatdsh/client-multi-window": "link:../../packages/client/multi-window",
    "@chatdsh/client-notifications": "link:../../packages/client/notifications",
    "@chatdsh/client-pwa": "link:../../packages/client/pwa",
    "@chatdsh/client-session-bridge": "link:../../packages/client/session-bridge",
    "@chatdsh/client-workspace-tools": "link:../../packages/client/workspace-tools",
    "@chatdsh/core-backends": "link:../../packages/core/backends",
    "@chatdsh/core-limits": "link:../../packages/core/limits",
    "@chatdsh/host-attachments": "link:../../packages/host/attachments",
    "@chatdsh/host-backup": "link:../../packages/host/backup",
    "@chatdsh/host-schedule-ui": "link:../../packages/host/schedule-ui",
    "@chatdsh/host-settings-enhancements": "link:../../packages/host/settings-enhancements",
    "@chatdsh/host-voice": "link:../../packages/host/voice",
    "@deepseek-ai/dsh-experimental-ralph-bundle": "0.2.1-rc.2",
    "@deepseek-harness-tui/dsh-tui": "0.16.1"
  },
  "dsh": {
    "profile": {
      "bundles": [
        "@deepseek-ai/dsh-base",
        "@deepseek-ai/dsh-experimental-ralph-bundle",
        "@deepseek-harness-tui/dsh-tui"
      ]
    }
  }
}
