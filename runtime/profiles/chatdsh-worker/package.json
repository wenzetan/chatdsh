{
  "name": "dsh-profile-chatdsh-worker",
  "version": "0.1.0",
  "private": true,
  "description": "ChatDSH 的长任务 profile：headless 运行，没有界面，由控制平面按任务驱动",
  "dependencies": {
    "@chatdsh/adapter": "link:../../../dsh-adapter",
    "@chatdsh/bundle-hosted": "link:../../packages/bundle/hosted",
    "@chatdsh/bundle-memory-hindsight": "link:../../packages/bundle/memory-hindsight",
    "@chatdsh/bundle-worker": "link:../../packages/bundle/worker",
    "@chatdsh/host-approval": "link:../../packages/host/approval",
    "@chatdsh/host-artifacts": "link:../../packages/host/artifacts",
    "@chatdsh/host-assistants": "link:../../packages/host/assistants",
    "@chatdsh/host-connectors": "link:../../packages/host/connectors",
    "@chatdsh/core-identity": "link:../../packages/core/identity",
    "@chatdsh/host-import": "link:../../packages/host/import",
    "@chatdsh/host-memory": "link:../../packages/host/memory",
    "@chatdsh/host-projects": "link:../../packages/host/projects",
    "@chatdsh/host-push": "link:../../packages/host/push",
    "@chatdsh/core-session-index": "link:../../packages/core/session-index",
    "@chatdsh/host-telemetry": "link:../../packages/host/telemetry",
    "@chatdsh/host-usage": "link:../../packages/host/usage"
  },
  "dsh": {
    "profile": {
      "bundles": [
        "@deepseek-ai/dsh-base",
        "@deepseek-ai/dsh-headless",
        "@chatdsh/bundle-hosted",
        "@chatdsh/bundle-memory-hindsight",
        "@chatdsh/bundle-worker"
      ]
    }
  }
}
