{
  "name": "chatdsh",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "build:client": "node scripts/build-client.mjs",
    "clean": "tsc -b tsconfig.build.json --clean",
    "typecheck": "tsc -b tsconfig.build.json",
    "test": "node --test --test-concurrency=1 e2e/unit/*.test.mjs",
    "check:telemetry": "node scripts/check-telemetry.mjs",
    "check:plugins": "node scripts/check-plugin-contract.mjs",
    "check:upstream-names": "node scripts/check-upstream-names.mjs",
    "check:layering": "node scripts/check-layering.mjs",
    "check:refer-repos": "node scripts/check-refer-repos.mjs",
    "clone:refer-repos": "node scripts/clone-refer-repos.mjs",
    "upgrade:dsh": "node scripts/upgrade-dsh.mjs",
    "verify:plugin-install": "node scripts/verify-plugin-install.mjs",
    "verify:device-link": "node scripts/verify-device-link.mjs",
    "verify:routing": "node scripts/verify-routing.mjs",
    "verify:settings-sync": "node scripts/verify-settings-sync.mjs",
    "verify:approval-notify": "node scripts/verify-approval-notify.mjs",
    "verify:import": "node scripts/verify-import.mjs",
    "verify:receipt-sync": "node scripts/verify-receipt-sync.mjs",
    "verify:multi-client": "node scripts/verify-multi-client.mjs",
    "verify:mobile-telemetry": "node scripts/verify-mobile-telemetry.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "typescript": "5.9.3",
    "yaml": "^2.7.0"
  }
}
