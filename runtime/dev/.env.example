# ChatDSH 开发环境的变量清单。
#
# 复制成 dev/.env 后按需填写：dev/.env 已被版本管理忽略，不会被提交。
#   cp dev/.env.example dev/.env
#   docker compose --env-file dev/.env -f dev/docker/compose.yaml up -d
#
# 容器内访问宿主上的服务统一走 host.docker.internal，compose 里已经配好这条映射。

# ── 模型网关 ──────────────────────────────────────────────────────────
# 模型网关地址。容器内访问宿主上的网关用这个地址。
CHATDSH_TEST_GATEWAY_URL=http://host.docker.internal:20128/v1
# 模型网关的密钥，留空表示不配置。
CHATDSH_TEST_GATEWAY_API_KEY=
# 模型网关上默认使用的模型名。
CHATDSH_TEST_GATEWAY_MODEL=

# 控制平面的模型入口：上游模型网关的 chat completions 地址。
CHATDSH_LLM_GATEWAY_URL=http://host.docker.internal:20128/v1/chat/completions
# 上游凭据所在的环境变量名，留空表示不带凭据。
CHATDSH_LLM_API_KEY_ENV=CHATDSH_TEST_GATEWAY_API_KEY
# 每账号额度上限与启动初值（token 数），上限留空表示不限制。
CHATDSH_LLM_QUOTA_LIMIT=
CHATDSH_LLM_QUOTA_USED=0

# ── dsh 运行时 ───────────────────────────────────────────────────────
# 宿主上仓库所在目录，容器以只读方式挂载到 /src，再复制到容器内的可写目录。
CHATDSH_WORKSPACE=/workspace/chatdsh
# dsh 运行时在宿主上暴露的端口。
DSH_HOST_PORT=13080
# dsh 运行时在容器内绑定的地址，留空表示自动取容器自己的地址。
DSH_BIND_HOST=
# 容器内安装的 dsh 版本。
DSH_VERSION=0.2.1-rc.2
# 容器内安装的 pnpm 版本。
PNPM_VERSION=10.33.0
# npm registry，容器内装包用这个源。
NPM_REGISTRY=https://registry.npmmirror.com

# ── Hermes ───────────────────────────────────────────────────────────
# Hermes 的 api_server 密钥，宿主侧用它访问 18642。
HERMES_API_KEY=example-hermes-api-key
# Hermes 镜像。
HERMES_IMAGE=nousresearch/hermes-agent:latest
# Hermes 在宿主上暴露的端口。
HERMES_HOST_PORT=18642

# ── Hindsight ────────────────────────────────────────────────────────
# Hindsight 在宿主上暴露的端口。
HINDSIGHT_HOST_PORT=18889
# Hindsight 镜像。
HINDSIGHT_IMAGE=ghcr.nju.edu.cn/vectorize-io/hindsight:0.9.2
# Hindsight 使用的 Postgres 镜像。
HINDSIGHT_DB_IMAGE=docker.1panel.live/tensorchord/vchord-postgres:pg18-v1.1.1
# Postgres 的用户名、库名与密码，容器内的连接串由这三个值拼出。
HINDSIGHT_DB_USER=hindsight
HINDSIGHT_DB_NAME=hindsight
HINDSIGHT_DB_PASSWORD=example-hindsight-db-password

# Hindsight 做记忆抽取与总结时用的 LLM。
HINDSIGHT_LLM_PROVIDER=openai
HINDSIGHT_LLM_BASE_URL=http://host.docker.internal:20128/v1
HINDSIGHT_LLM_MODEL=
HINDSIGHT_LLM_API_KEY=

# Hindsight 做向量检索时用的 embeddings 模型。
HINDSIGHT_EMBEDDINGS_PROVIDER=openai
HINDSIGHT_EMBEDDINGS_BASE_URL=http://host.docker.internal:20128/v1
HINDSIGHT_EMBEDDINGS_MODEL=
HINDSIGHT_EMBEDDINGS_API_KEY=

# ── 自动化（webhook 路由）────────────────────────────────────────────
# webhook 的共享密钥；自动化记录里的 trigger.secretEnv 指向这个环境变量名。
CHATDSH_WEBHOOK_SECRET=
# 控制平面自己的访问令牌。
CHATDSH_GATEWAY_TOKEN=
# 自动化调试编排暴露的宿主端口。
AUTOMATION_HOST_PORT=13171
