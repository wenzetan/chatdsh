{
  "name": "@chatdsh/gateway",
  "version": "0.1.0",
  "description": "ChatDSH 轻量中继服务端：设备配对与长连接转发、会话只读副本、设置同步、审批推送与 PWA 入口",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "chatdsh-gateway": "lib/main.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "chatdsh": {
    "telemetry": {
      "events": [
        "chatdsh.gateway.mobile.rejected",
        "chatdsh.gateway.mobile.telemetry.rejected",
        "chatdsh.gateway.device.rejected",
        "chatdsh.gateway.device.disconnected",
        "chatdsh.gateway.ownership.rejected",
        "chatdsh.gateway.settings.rejected",
        "chatdsh.gateway.client.rejected",
        "chatdsh.gateway.push.failed",
        "chatdsh.gateway.push.withdrawn",
        "chatdsh.gateway.push.subscription.expired",
        "chatdsh.gateway.notification.rejected"
      ],
      "spans": [
        "chatdsh.gateway.http",
        "chatdsh.gateway.replica.append",
        "chatdsh.gateway.mobile.telemetry",
        "chatdsh.gateway.mobile.devices",
        "chatdsh.gateway.device.pair",
        "chatdsh.gateway.device.link",
        "chatdsh.gateway.device.request",
        "chatdsh.gateway.device.proxy",
        "chatdsh.gateway.device.plugins",
        "chatdsh.gateway.sessions.list",
        "chatdsh.gateway.ownership.write",
        "chatdsh.gateway.settings.read",
        "chatdsh.gateway.settings.write",
        "chatdsh.gateway.client.request",
        "chatdsh.gateway.notification.record",
        "chatdsh.gateway.notification.list",
        "chatdsh.gateway.notification.read",
        "chatdsh.gateway.notification.handled",
        "chatdsh.gateway.notification.settings",
        "chatdsh.gateway.notification.subscription",
        "chatdsh.gateway.notification.probe",
        "chatdsh.push.dispatch",
        "chatdsh.push.send"
      ],
      "metrics": [
        "chatdsh_http_request_duration_seconds",
        "chatdsh_http_requests_total",
        "chatdsh_push_deliveries_total",
        "chatdsh_push_sends_total",
        "chatdsh_push_subscriptions_total",
        "chatdsh_gateway_notifications_total",
        "chatdsh_gateway_notification_settings_total",
        "chatdsh_telemetry_dropped_total",
        "chatdsh_mobile_telemetry_batches_total",
        "chatdsh_mobile_telemetry_records_total",
        "chatdsh_mobile_devices_total",
        "chatdsh_gateway_device_pairs_total",
        "chatdsh_gateway_device_links_total",
        "chatdsh_gateway_device_requests_total",
        "chatdsh_gateway_device_proxies_total",
        "chatdsh_gateway_device_plugins_total",
        "chatdsh_gateway_ownership_writes_total",
        "chatdsh_gateway_settings_writes_total",
        "chatdsh_gateway_client_requests_total"
      ]
    }
  },
  "dependencies": {
    "@chatdsh/core-contracts": "workspace:*",
    "@chatdsh/core-diagnostics": "workspace:*"
  }
}
