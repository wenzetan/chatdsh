{
  "name": "@chatdsh/host-artifacts",
  "version": "0.1.0",
  "description": "ChatDSH 宿主平面插件：制品的版本、安全读取与删除范围，内容在产品数据目录，元数据在结构化存储",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "peerDependencies": {
    "zod": "4.4.3"
  },
  "dependencies": {
    "@chatdsh/adapter": "link:../../../../dsh-adapter"
  },
  "chatdsh": {
    "telemetry": {
      "events": [
        "chatdsh.runtime.artifact.rejected"
      ],
      "spans": [
        "chatdsh.runtime.artifact.access"
      ],
      "metrics": [
        "chatdsh_artifact_operations_total"
      ]
    }
  }
}
