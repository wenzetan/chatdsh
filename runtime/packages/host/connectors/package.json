{
  "name": "@chatdsh/host-connectors",
  "version": "0.1.0",
  "description": "ChatDSH 宿主平面插件：连接器的条件校验、凭据环境变量名与加载器同步状态",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "dependencies": {
    "@chatdsh/adapter": "link:../../../../dsh-adapter",
    "zod": "4.4.3",
    "@chatdsh/core-contracts": "workspace:*"
  },
  "chatdsh": {
    "telemetry": {
      "events": [
        "chatdsh.connectors.sync.failed",
        "chatdsh.connectors.rejected"
      ],
      "spans": [
        "chatdsh.connectors.sync",
        "chatdsh.connectors.change"
      ],
      "metrics": [
        "chatdsh_connectors_sync_total",
        "chatdsh_connector_changes_total"
      ]
    }
  }
}
