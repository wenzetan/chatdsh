{
  "name": "@chatdsh/host-skills",
  "version": "0.1.0",
  "description": "ChatDSH 宿主平面插件：技能目录的启用状态、启用决定持久化与来源检索，供面板与工具读取",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "chatdsh": {
    "telemetry": {
      "events": [
        "chatdsh.runtime.skill.rejected"
      ],
      "spans": [
        "chatdsh.runtime.skill.toggle",
        "chatdsh.runtime.skill.search"
      ],
      "metrics": [
        "chatdsh_skill_toggles_total",
        "chatdsh_skill_searches_total"
      ]
    }
  },
  "dependencies": {
    "@chatdsh/adapter": "link:../../../../dsh-adapter",
    "@chatdsh/core-contracts": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-skill": "0.2.1-rc.2",
    "zod": "4.4.3"
  }
}
