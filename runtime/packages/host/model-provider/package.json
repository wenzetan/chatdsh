{
  "name": "@chatdsh/host-model-provider",
  "version": "0.1.0",
  "description": "ChatDSH 宿主平面插件：注册模型提供方路由，校验端点与请求头",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "chatdsh": {
    "telemetry": {
      "events": [
        "chatdsh.runtime.model.provider.failed"
      ],
      "spans": [
        "chatdsh.runtime.model.provider.resolve",
        "chatdsh.runtime.remote.call"
      ],
      "metrics": [
        "chatdsh_model_provider_resolutions_total",
        "chatdsh_remote_calls_total"
      ]
    }
  },
  "dependencies": {
    "@chatdsh/adapter": "link:../../../../dsh-adapter",
    "@chatdsh/core-backends": "workspace:*",
    "@chatdsh/core-contracts": "workspace:*"
  }
}
