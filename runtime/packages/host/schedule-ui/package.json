{
  "name": "@chatdsh/host-schedule-ui",
  "version": "0.1.0",
  "description": "ChatDSH 宿主平面插件：把原会话的 ctx.schedule 定时任务整理成界面可读的视图，提供列举、创建、编辑、取消与删除入口",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "dependencies": {
    "@chatdsh/adapter": "link:../../../../dsh-adapter",
    "@chatdsh/core-contracts": "workspace:*"
  },
  "chatdsh": {
    "telemetry": {
      "spans": [
        "chatdsh.runtime.remote.call"
      ],
      "metrics": [
        "chatdsh_remote_calls_total",
        "chatdsh_remote_call_duration_seconds"
      ]
    }
  }
}
