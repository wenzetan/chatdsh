{
  "name": "@chatdsh/host-assistants",
  "version": "0.1.0",
  "description": "ChatDSH 宿主平面插件：自定义助手的存储与 preset 装配",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "peerDependencies": {
    "zod": "4.4.3"
  },
  "dependencies": {
    "@chatdsh/adapter": "link:../../../../dsh-adapter",
    "@chatdsh/core-contracts": "workspace:*"
  },
  "chatdsh": {
    "telemetry": {
      "events": [
        "chatdsh.runtime.assistant.rejected"
      ],
      "spans": [
        "chatdsh.runtime.assistant.write"
      ],
      "metrics": [
        "chatdsh_runtime_assistant_writes_total"
      ]
    }
  }
}
