{
  "name": "@chatdsh/host-memory",
  "version": "0.1.0",
  "description": "ChatDSH 宿主平面插件：记忆接入层（bank 规则、召回、写入、降级上报）",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "chatdsh": {
    "telemetry": {
      "events": [
        "chatdsh.memory.degraded",
        "chatdsh.memory.search.failed",
        "chatdsh.memory.group.rejected",
        "chatdsh.memory.write.failed",
        "chatdsh.memory.queue.rejected"
      ],
      "spans": [
        "chatdsh.memory.recall",
        "chatdsh.memory.write",
        "chatdsh.memory.summary",
        "chatdsh.memory.search",
        "chatdsh.memory.group.save",
        "chatdsh.memory.group.detach",
        "chatdsh.memory.write.queue"
      ],
      "metrics": [
        "chatdsh_memory_recall_seconds",
        "chatdsh_memory_injections_total",
        "chatdsh_memory_searches_total",
        "chatdsh_memory_group_changes_total",
        "chatdsh_memory_writes_total",
        "chatdsh_memory_queue_actions_total"
      ]
    }
  },
  "dependencies": {
    "@chatdsh/adapter": "link:../../../../dsh-adapter",
    "@chatdsh/core-contracts": "workspace:*",
    "@chatdsh/hindsight-adapter": "link:../../../../hindsight-adapter"
  }
}
