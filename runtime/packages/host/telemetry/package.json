{
  "name": "@chatdsh/host-telemetry",
  "version": "0.1.0",
  "description": "ChatDSH 宿主平面插件：注册 ctx.chatdshTelemetry，提供状态、自检与浏览器上报中继端点",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@chatdsh/adapter": "0.1.0",
    "@chatdsh/core-contracts": "workspace:*",
    "@chatdsh/core-diagnostics": "workspace:*"
  }
}
