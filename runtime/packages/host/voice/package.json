{
  "name": "@chatdsh/host-voice",
  "version": "0.1.0",
  "description": "ChatDSH 宿主平面插件：录音文件、录音元数据与转写文本分开存储，转写交给成熟识别接口",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "peerDependencies": {
    "zod": "4.4.3"
  },
  "dependencies": {
    "@chatdsh/adapter": "link:../../../../dsh-adapter"
  },
  "chatdsh": {
    "telemetry": {
      "events": [],
      "spans": [
        "chatdsh.runtime.remote.call"
      ],
      "metrics": [
        "chatdsh_remote_calls_total"
      ]
    }
  }
}
