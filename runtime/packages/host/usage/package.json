{
  "name": "@chatdsh/host-usage",
  "version": "0.1.0",
  "description": "ChatDSH 宿主平面插件：会话级 token 用量投影，供用量视图与控制平面账本读取",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types.d.ts",
      "default": "./lib/types.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "chatdsh": {
    "telemetry": {
      "spans": [
        "chatdsh.runtime.remote.call"
      ],
      "metrics": [
        "chatdsh_remote_calls_total"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.2",
    "zod": "4.4.3"
  },
  "dependencies": {
    "@chatdsh/adapter": "link:../../../../dsh-adapter"
  }
}
