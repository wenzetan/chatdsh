{
  "name": "@chatdsh/host-device-link",
  "version": "0.1.0",
  "description": "ChatDSH 宿主平面插件：设备主动连到控制平面，接收并本地执行转发来的请求",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "license": "MIT",
  "chatdsh": {
    "telemetry": {
      "events": [
        "chatdsh.runtime.device.rejected",
        "chatdsh.runtime.device.forward.failed"
      ],
      "spans": [
        "chatdsh.runtime.device.link",
        "chatdsh.runtime.device.forward"
      ],
      "metrics": [
        "chatdsh_runtime_device_links_total",
        "chatdsh_runtime_device_forwards_total"
      ]
    }
  },
  "dependencies": {
    "@chatdsh/adapter": "link:../../../../dsh-adapter",
    "@chatdsh/core-contracts": "workspace:*"
  }
}
