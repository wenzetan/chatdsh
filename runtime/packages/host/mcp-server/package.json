{
  "name": "@chatdsh/host-mcp-server",
  "version": "0.1.0",
  "description": "ChatDSH 宿主平面插件：把工具目录暴露为 MCP 服务端",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "chatdsh": {
    "telemetry": {
      "events": [
        "chatdsh.mcp.auth.rejected"
      ],
      "spans": [
        "chatdsh.mcp.session.initialize",
        "chatdsh.mcp.tools.list",
        "chatdsh.mcp.tools.call"
      ],
      "metrics": [
        "chatdsh_mcp_calls_total",
        "chatdsh_mcp_call_duration_seconds"
      ]
    }
  },
  "dependencies": {
    "@chatdsh/adapter": "link:../../../../dsh-adapter",
    "@chatdsh/core-contracts": "workspace:*"
  },
  "peerDependencies": {
    "@modelcontextprotocol/core": "2.2.0"
  }
}
