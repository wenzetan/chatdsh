{
  "name": "@chatdsh/host-llm-router",
  "version": "0.1.0",
  "description": "ChatDSH 宿主平面插件：模型适配器，转发到控制平面的模型入口并在 stream() 入口做额度检查",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "chatdsh": {
    "telemetry": {
      "events": [
        "chatdsh.llm.quota.rejected"
      ],
      "spans": [
        "chatdsh.llm.stream"
      ],
      "metrics": [
        "chatdsh_llm_requests_total",
        "chatdsh_llm_request_duration_seconds",
        "chatdsh_llm_first_token_seconds",
        "chatdsh_llm_tokens_total"
      ]
    }
  },
  "dependencies": {
    "@chatdsh/adapter": "link:../../../../dsh-adapter",
    "@chatdsh/core-contracts": "workspace:*"
  }
}
