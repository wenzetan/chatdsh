{
  "name": "@chatdsh/host-push",
  "version": "0.1.0",
  "description": "ChatDSH 宿主平面插件：把会话事件信封上报控制平面，形成只读副本",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "license": "MIT",
  "chatdsh": {
    "telemetry": {
      "events": [
        "chatdsh.sync.watermark"
      ],
      "spans": [
        "chatdsh.sync.event.push"
      ],
      "metrics": [
        "chatdsh_replica_lag_sessions"
      ]
    }
  },
  "dependencies": {
    "@chatdsh/adapter": "0.1.0",
    "@chatdsh/core-contracts": "workspace:*"
  }
}
