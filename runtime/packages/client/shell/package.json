{
  "name": "@chatdsh/client-shell",
  "version": "0.1.0",
  "description": "ChatDSH 客户端外壳：左栏聚合全部设备的会话，右栏是 iframe",
  "type": "module",
  "main": "lib/client/index.js",
  "types": "lib/client/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "chatdsh": {
    "shell": {
      "entry": "src/client/index.ts",
      "asset": "gateway/lib/shell/shell.js"
    },
    "telemetry": {
      "events": [
        "chatdsh.client.ui.action"
      ],
      "spans": [
        "chatdsh.client.remote.call"
      ],
      "metrics": []
    }
  }
}
