{
  "name": "@chatdsh/client-session-bridge",
  "version": "0.1.0",
  "description": "ChatDSH 设备内导航桥：宿主与设备内容席位之间的导航握手、准确会话确认、超时重试与来源校验",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "chatdsh": {
    "telemetry": {
      "events": [
        "chatdsh.client.navigate.rejected"
      ],
      "spans": [
        "chatdsh.client.navigate"
      ],
      "metrics": [
        "chatdsh_client_navigations_total"
      ]
    }
  }
}
