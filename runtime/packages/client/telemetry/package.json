{
  "name": "@chatdsh/client-telemetry",
  "version": "0.1.0",
  "description": "ChatDSH 客户端插件：浏览器侧错误采集与同源上报",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [],
      "immediately": true
    }
  },
  "chatdsh": {
    "telemetry": {
      "events": [
        "chatdsh.client.error"
      ],
      "spans": [],
      "metrics": [
        "chatdsh_client_errors_total"
      ]
    }
  },
  "dependencies": {
    "@chatdsh/core-contracts": "workspace:*",
    "@chatdsh/core-diagnostics": "workspace:*"
  }
}
