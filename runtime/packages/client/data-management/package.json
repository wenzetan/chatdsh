{
  "name": "@chatdsh/client-data-management",
  "version": "0.1.0",
  "description": "ChatDSH 客户端插件：设置页里的用量、副本清理、只读副本、血缘、导入与删除收件箱",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "chatdsh": {
    "telemetry": {
      "events": [
        "chatdsh.client.error",
        "chatdsh.client.ui.action"
      ],
      "spans": [
        "chatdsh.client.remote.call"
      ],
      "metrics": [
        "chatdsh_client_errors_total"
      ]
    }
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "dependencies": {
    "@chatdsh/core-contracts": "workspace:*",
    "@chatdsh/core-ui-kit": "workspace:*",
    "zod": "4.4.3"
  }
}
