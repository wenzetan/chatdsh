{
  "name": "@chatdsh/client-multi-window",
  "version": "0.1.0",
  "description": "ChatDSH 客户端插件：第二窗口与分屏，新窗口深链接、共用运行时、每窗口选择与草稿、分隔条键盘操作与并发冲突展示",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "chatdsh": {
    "telemetry": {
      "events": [
        "chatdsh.client.ui.action",
        "chatdsh.client.error"
      ],
      "spans": [
        "chatdsh.client.navigate",
        "chatdsh.client.command.run"
      ],
      "metrics": [
        "chatdsh_client_navigations_total",
        "chatdsh_client_command_runs_total",
        "chatdsh_client_errors_total"
      ]
    }
  }
}
