{
  "name": "@chatdsh/client-projects",
  "version": "0.1.0",
  "description": "ChatDSH 客户端插件：侧栏里的项目面板",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "dependencies": {
    "@chatdsh/core-remote-client": "workspace:*",
    "zod": "4.4.3",
    "@chatdsh/core-ui-kit": "workspace:*"
  }
}
