{
  "name": "@chatdsh/client-conversation",
  "version": "0.1.0",
  "description": "ChatDSH 会话增强客户端：消息呈现、组合输入、在线队列、命令与触发面板、引用对象、准确停止与来源标记",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "dependencies": {
    "@chatdsh/core-contracts": "workspace:*",
    "@chatdsh/core-ui-kit": "workspace:*",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "chatdsh": {
    "telemetry": {
      "events": [
        "chatdsh.client.message.rejected",
        "chatdsh.client.stream.interrupted",
        "chatdsh.client.queue.rejected",
        "chatdsh.client.command.rejected",
        "chatdsh.client.reference.invalidated"
      ],
      "spans": [
        "chatdsh.client.message.send",
        "chatdsh.client.stream.consume",
        "chatdsh.client.queue.consume",
        "chatdsh.client.command.run"
      ],
      "metrics": [
        "chatdsh_client_message_sends_total",
        "chatdsh_client_stream_events_total",
        "chatdsh_client_queue_actions_total",
        "chatdsh_client_command_runs_total",
        "chatdsh_client_reference_changes_total"
      ]
    }
  }
}
