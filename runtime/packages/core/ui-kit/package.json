{
  "name": "@chatdsh/core-ui-kit",
  "version": "0.1.0",
  "description": "ChatDSH 客户端面板的界面组件：只引用界面基础设计的令牌，供各客户端插件复用",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "peerDependencies": {
    "react": ">=19"
  }
}
