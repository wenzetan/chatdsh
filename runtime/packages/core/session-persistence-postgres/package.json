{
  "name": "@chatdsh/core-session-persistence-postgres",
  "version": "0.1.0",
  "description": "ChatDSH 的 PostgreSQL 会话持久化后端：会话头与事件日志存 Postgres",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["lib/**/*.js", "lib/**/*.d.ts"],
  "license": "MIT",
  "engines": { "dsh": ">=0.2.1-rc.2 <0.3.0-0" },
  "chatdsh": {
    "telemetry": {
      "events": ["chatdsh.session.persist.ownership.lost"],
      "spans": [
        "chatdsh.session.persist.open",
        "chatdsh.session.persist.append",
        "chatdsh.session.persist.flush"
      ],
      "metrics": [
        "chatdsh_session_persist_appends_total",
        "chatdsh_session_persist_ownership_losses_total"
      ]
    }
  },
  "dependencies": {
    "@chatdsh/adapter": "link:../../../../dsh-adapter",
    "pg": "8.16.3"
  }
}
