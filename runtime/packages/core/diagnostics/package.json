{
  "name": "@chatdsh/core-diagnostics",
  "version": "0.1.0",
  "description": "可复用的诊断客户端与 OTLP 管道：开关、脱敏、自建 W3C 链路上下文、有界环形缓冲与自监控",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./config": {
      "types": "./lib/config.d.ts",
      "default": "./lib/config.js"
    },
    "./pipelines": {
      "types": "./lib/pipelines.d.ts",
      "default": "./lib/pipelines.js"
    },
    "./redact": {
      "types": "./lib/redact.d.ts",
      "default": "./lib/redact.js"
    },
    "./trace-context": {
      "types": "./lib/trace-context.d.ts",
      "default": "./lib/trace-context.js"
    },
    "./ring-buffer": {
      "types": "./lib/ring-buffer.d.ts",
      "default": "./lib/ring-buffer.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "chatdsh": {
    "telemetry": {
      "events": [
        "chatdsh.telemetry.dropped",
        "chatdsh.telemetry.enabled",
        "chatdsh.telemetry.invalid"
      ],
      "spans": [
        "chatdsh.telemetry.probe"
      ],
      "metrics": [
        "chatdsh_telemetry_dropped_total",
        "chatdsh_telemetry_export_duration_seconds",
        "chatdsh_telemetry_export_failures_total",
        "chatdsh_telemetry_queue_depth",
        "chatdsh_telemetry_self_test_total"
      ]
    }
  },
  "dependencies": {
    "@chatdsh/core-contracts": "workspace:*",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/otlp-exporter-base": "0.222.0",
    "@opentelemetry/otlp-transformer": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-logs": "0.222.0",
    "@opentelemetry/sdk-metrics": "2.11.0",
    "@opentelemetry/sdk-trace": "2.11.0"
  }
}
