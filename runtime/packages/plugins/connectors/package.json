{
  "name": "@chatdsh/plugin-connectors",
  "version": "0.1.0",
  "description": "ChatDSH 宿主平面插件：连接器记录（名称、传输方式、凭据环境变量名）",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "dependencies": {
    "@chatdsh/adapter": "link:../../../../chatdsn-adapter",
    "zod": "4.4.3"
  },
  "chatdsh": {
    "telemetry": {
      "events": [
        "chatdsh.connectors.sync.failed"
      ],
      "spans": [
        "chatdsh.connectors.sync"
      ],
      "metrics": [
        "chatdsh_connectors_sync_total"
      ]
    }
  }
}
