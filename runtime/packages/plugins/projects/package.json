{
  "name": "@chatdsh/plugin-projects",
  "version": "0.1.0",
  "description": "ChatDSH 宿主平面插件：在工作区之上扩展标题、项目说明与默认模型，并把项目说明注入会话上下文",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "peerDependencies": {
    "zod": "4.4.3"
  },
  "dependencies": {
    "@chatdsh/adapter": "link:../../../../dsh-adapter"
  }
}
