{
  "name": "@chatdsh/adapter",
  "version": "0.1.0",
  "type": "module",
  "description": "DSH 内部 API 的唯一接触面：集中转出插件实际使用的顶层服务、会话事件与配置命名空间",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./events": {
      "types": "./lib/events.d.ts",
      "default": "./lib/events.js"
    },
    "./upstream": {
      "types": "./lib/upstream.d.ts",
      "default": "./lib/upstream.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "src/**/*.ts"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/schemastery": ">=3.18.0",
    "@deepseek-ai/dsh-client-connection": ">=0.2.0-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.0-0",
    "@deepseek-ai/dsh-session": ">=0.2.0-0",
    "@deepseek-ai/dsh-session-persistence": ">=0.2.0-0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.0-0"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "clean": "tsc -b tsconfig.build.json --clean",
    "typecheck": "tsc -b tsconfig.build.json",
    "test": "node --test 'test/*.test.mjs'"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
