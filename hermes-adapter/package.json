{
  "name": "@chatdsh/hermes-adapter",
  "version": "0.1.0",
  "private": true,
  "description": "ChatDSH 的 Hermes 适配器：把 Hermes 的 OpenAI 兼容服务翻译成聊天后端契约",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "src/**/*.ts"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "clean": "tsc -b tsconfig.build.json --clean",
    "test": "node --test 'test/*.test.mjs'"
  },
  "dependencies": {
    "@chatdsh/core-contracts": "link:../runtime/packages/core/contracts"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "^24.0.0"
  }
}
