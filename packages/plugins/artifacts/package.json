{
  "name": "@chatdsh/plugin-artifacts",
  "version": "0.1.0",
  "description": "ChatDSH 宿主平面插件：制品的存储与版本，内容在产品数据目录，元数据在结构化存储",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "peerDependencies": {
    "zod": "4.4.3"
  },
  "dependencies": {
    "@chatdsh/adapter": "link:../../../../chatdsn-adapter"
  }
}
