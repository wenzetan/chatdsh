{
  "name": "@chatdsh/plugin-import",
  "version": "0.1.0",
  "description": "ChatDSH 宿主机平面插件：把控制平面的会话副本恢复成本地会话",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./seed": {
      "types": "./lib/seed.d.ts",
      "default": "./lib/seed.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "chatdsh": {
    "telemetry": {
      "events": [
        "chatdsh.import.seed.failed"
      ],
      "spans": [
        "chatdsh.import.seed"
      ],
      "metrics": [
        "chatdsh_import_seed_total"
      ]
    }
  },
  "dependencies": {
    "@chatdsh/adapter": "link:../../../../chatdsn-adapter"
  }
}
