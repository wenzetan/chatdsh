# ChatDSH 中继服务端环境变量模板
# 首次运行 `bash scripts/relay-up.sh` 时会询问域名并自动生成配对口令保存到 `.env`。

# 对外访问的精确 origin（必填，例如 https://relay.example.com）
CHATDSH_PUBLIC_URL=https://relay.example.com

# 设备与手机配对口令（留空时由 scripts/relay-up.sh 首次自动随机生成并持久化；
# 全部设备配对完成后可执行 `bash scripts/relay-up.sh --disable-pairing` 清空以关闭配对入口）
CHATDSH_PAIRING_CODE=

# 配对审批策略：required（默认，客户端申请配对后需中继服务端审批放行）或 auto
CHATDSH_PAIRING_APPROVAL=required

# 宿主机监听地址与端口：严禁设为 0.0.0.0 或 ::
# 默认 127.0.0.1（供本机 Nginx/Caddy/Tailscale Serve/cloudflared 转发），或设为具体内网穿透网卡 IP
CHATDSH_GATEWAY_BIND_HOST=127.0.0.1
CHATDSH_GATEWAY_BIND_PORT=3170

# 访问认证模式：disabled（仅限 Tailscale 或受信任内网）或 required（公网暴露强烈建议开启，或在反向代理启用前置认证）
CHATDSH_ACCESS_MODE=disabled

# 通知投递模式：two-stage 或 all-at-once
CHATDSH_PUSH_MODE=two-stage
CHATDSH_PUSH_ESCALATION_MS=120000

# Web Push VAPID（留空时首次启动自动生成并持久化在容器数据卷 SQLite 中）
CHATDSH_VAPID_SUBJECT=mailto:chatdsh@localhost
CHATDSH_VAPID_PUBLIC_KEY=
CHATDSH_VAPID_PRIVATE_KEY=

# 遥测开关与端点（设为 off 关闭遥测）
CHATDSH_TELEMETRY=off
CHATDSH_TELEMETRY_ENDPOINT=http://127.0.0.1:5080
CHATDSH_TELEMETRY_ORG=default
CHATDSH_TELEMETRY_USER=
CHATDSH_TELEMETRY_PASSWORD=
CHATDSH_ENVIRONMENT=production
