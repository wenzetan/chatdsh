registry=https://registry.npmmirror.com
link-workspace-packages=true
save-workspace-protocol=rolling
strict-peer-dependencies=false
# DSH 的包不由包管理器安装：它们由 profile 目录在部署时安装，开发期的类型解析走
# tsconfig.base.json 的 paths 指向 .dsh-deps（scripts/link-dsh-deps.mjs 生成）。
auto-install-peers=false
# 依赖存储放在工作区内：容器里用户级缓存目录不可写，且存储与项目应当同处一个可写目录。
store-dir=.run/pnpm-store
